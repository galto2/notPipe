<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Holo.Light">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:actionBarStyle">@style/YouTubeActionBar</item>
    </style>
    <style name="YouTubeActionBar" parent="@android:style/Widget.Holo.Light.ActionBar">
        <item name="android:background">#FFFFFF</item>
        <item name="android:displayOptions">showHome|showTitle|useLogo</item>
        <item name="android:titleTextStyle">@style/YouTubeActionBarTitle</item>
    </style>
    <style name="YouTubeActionBarTitle" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Title">
        <item name="android:textColor">#212121</item>
    </style>
</resources>
